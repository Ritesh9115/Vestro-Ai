# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Frontend URL ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ─── Financial APIs ───────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key
FMP_API_KEY=your_fmp_api_key
NEWS_API_KEY=your_news_api_key

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vestro?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-256-bit-secret
JWT_REFRESH_SECRET=change-this-to-a-different-random-256-bit-secret
JWT_EXPIRY=15m
REFRESH_EXPIRY=7d

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Email (Nodemailer / Gmail App Password) ──────────────────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Vestro AI <noreply@vestro.ai>

# ─── Proxy (optional) ─────────────────────────────────────────────────────────
PROXY_HOST=your_proxy_host
PROXY_PORT=your_proxy_port
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password
